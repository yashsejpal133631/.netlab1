@model Product
@{ ViewData["Title"] = "Delete Product"; }
<div class="form-wrap"><div class="card border-0 shadow-sm p-4 text-center">
<div class="delete-icon">!</div>
<h1>Delete Product?</h1>
<p class="text-muted">You are about to permanently delete> <strong>@Model.ProductName</strong> (ID #@Model.ProductId).</p>
<div class="summary mx-auto mb-3">
<span>Category</span>
<strong>@Model.Category</strong><span>Stock</span>
<strong>@Model.Quantity</strong><span>Price</span><strong>₹@Model.Price.ToString("N2")</strong></div>
<form asp-action="Delete" method="post">
<input type="hidden" asp-for="ProductId" />
<button class="btn btn-danger px-4">Yes, Delete</button> 
<a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form>
</div></div>

