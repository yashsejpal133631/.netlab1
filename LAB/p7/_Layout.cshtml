<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>
        @ViewBag.Title - Feedback Management
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>

        body {
            background-color: #f4f6f9;
        }

        .navbar-brand {
            font-weight: bold;
        }

        .main-content {
            max-width: 900px;
            margin: 40px auto;
        }

        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        }

        .footer {
            text-align: center;
            padding: 20px;
            margin-top: 50px;
            color: #777;
        }
    </style>

</head>

<body>

    <!-- Navigation -->

    <nav class="navbar navbar-dark bg-dark">

        <div class="container">

            <a class="navbar-brand"
               href="/Feedback/Index">

                Feedback Management

            </a>

            <span class="text-white">
                MVC Practical
            </span>

        </div>

    </nav>


    <!-- Main Content -->

    <div class="main-content">

        @RenderBody()

    </div>


    <!-- Footer -->

    <div class="footer">

        <p>
            Feedback Management System
        </p>

    </div>

</body>
</html>
