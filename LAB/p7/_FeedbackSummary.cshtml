<div class="alert alert-info">

    <h5>
        Feedback Summary
    </h5>

    <p>
        <strong>Name:</strong>
        @ViewBag.Name
    </p>

    <p>
        <strong>Category:</strong>
        @ViewBag.Category
    </p>

    <p>
        <strong>Rating:</strong>
        @ViewBag.Rating / 5
    </p>

</div>
